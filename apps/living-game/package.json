{
  "name": "@homebase/living-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "vue-tsc --noEmit && WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build",
    "build:preview": "vite build --config vite.preview.config.ts",
    "watch:preview": "vite build --watch --config vite.preview.config.ts",
    "preview": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite preview",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@homebase/contracts": "file:../../packages/contracts",
    "hono": "^4.9.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/workers-types": "^5.20260811.1",
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "9.39.4",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.2.1",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.0.5",
    "wrangler": "4.123.0"
  }
}
