{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // `@homebase/contracts` is consumed as source, and its internal imports
    // carry the explicit `.ts` extension the runtime resolves.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["index.ts"]
}
